# Copy this file to .env and fill in your values
# Never commit .env to version control

# Zendesk credentials
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Voyage AI — only required if embeddings.provider is set to "voyage" in config.yaml
VOYAGE_API_KEY=pa-your_voyage_key_here

# Override Zendesk base URL (useful for pointing at mock server during local dev)
# ZENDESK_BASE_URL=http://localhost:9000
